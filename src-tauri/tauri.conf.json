{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPFL OpenWork Setup",
  "version": "0.1.0",
  "identifier": "ch.epfl.enac.openwork-setup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EPFL OpenWork Setup",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MjgzQTQ3RTA4QUMxMzMKUldRendZcmdSem9vVjB5VHk5MzJDSVpaMHVzSThyUUFOMzBRZDBlSklhbXVFWjJ3Vk5mQkVZY1YK",
      "endpoints": [
        "https://github.com/EPFL-ENAC/enac-openwork-installer/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
